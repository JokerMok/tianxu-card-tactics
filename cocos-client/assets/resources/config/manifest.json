{
  "schemaVersion": 1,
  "id": "CONFIG-MANIFEST",
  "evidenceLevel": "C",
  "version": 1,
  "enabled": true,
  "tables": {
    "units": "config/units",
    "cards": "config/cards"
  },
  "idPolicy": {
    "scope": "global",
    "format": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
    "stable": true,
    "unique": true
  },
  "evidenceLevels": [
    "A",
    "B",
    "C"
  ]
}
