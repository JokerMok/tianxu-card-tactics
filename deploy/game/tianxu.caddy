tianxu.shizibandu.icu {
    encode zstd gzip
    request_body {
        max_size 2MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options SAMEORIGIN
    }
    reverse_proxy 127.0.0.1:18875 {
        header_up X-Real-IP {http.request.remote.host}
    }
}
