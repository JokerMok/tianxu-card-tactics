# Image and loopback-only published port
TIANXU_IMAGE=tianxu-game:local
TIANXU_PUBLISHED_PORT=7400

# Process listener inside the container. Keep 0.0.0.0 for Docker port forwarding.
TIANXU_HOST=0.0.0.0
TIANXU_PORT=7400

# Regenerable runtime inputs inside the packaged image
TIANXU_CONTENT_DIR=/srv/tianxu/cocos-client/assets/resources/recovered
TIANXU_WEB_DIR=/srv/tianxu/.local/web
TIANXU_UI_DIR=/srv/tianxu/cocos-client/assets/resources/ui-revision-a
TIANXU_LOCALIZATION_DIR=/srv/tianxu/cocos-client/assets/resources/localization

# Persistent/mutable container paths
TIANXU_DATABASE=/var/lib/tianxu/tianxu.sqlite
TIANXU_LOG_DIR=/var/log/tianxu

# Separate host bind mounts; these default below deploy/game and remain ignored in .local.
TIANXU_DATA_DIR=../../.local/deploy/data
TIANXU_LOG_HOST_DIR=../../.local/deploy/logs
TIANXU_BACKUP_DIR=../../.local/deploy/backups

# Set to the owner of the three writable host directories (id -u / id -g).
TIANXU_UID=1000
TIANXU_GID=1000
