{
  "version": 1,
  "runtimeRoot": ".",
  "fixedFiles": [
    "deploy/game/Dockerfile",
    "scripts/game-data.mjs",
    "scripts/start-game.mjs",
    "cocos-client/assets/scripts/game/BattleKernel.ts",
    "cocos-client/assets/scripts/game/RecoveredContent.ts",
    "cocos-client/assets/scripts/game/RecoveredEffects.ts",
    "cocos-client/assets/scripts/game/GameContracts.ts",
    "cocos-client/assets/scripts/game/TerrainRules.ts",
    "scripts/gm-admin.mjs",
    "cocos-client/assets/scripts/game/GameText.ts",
    "backend/gm-web/index.html",
    "backend/gm-web/app.js",
    "backend/gm-web/style.css",
    "deploy/game/compose.yaml",
    "cocos-client/assets/scripts/game/StageScope.ts"
  ],
  "backend": {
    "directory": "backend/game",
    "extension": ".mjs",
    "excludeSuffix": ".test.mjs"
  },
  "web": {
    "directory": ".local/web",
    "requiredEntry": "index.html"
  },
  "content": {
    "directory": "cocos-client/assets/resources/recovered",
    "catalog": "catalog.json",
    "metadata": [
      "original-ui.json",
      "item-ui.json"
    ],
    "tableScope": "main:",
    "assetScope": "main",
    "includeOriginalUiTree": true
  },
  "localization": {
    "directory": "cocos-client/assets/resources/localization",
    "files": [
      "game-zh.json"
    ]
  },
  "ui": {
    "directory": "cocos-client/assets/resources/ui-revision-a"
  },
  "art": {
    "directory": "cocos-client/assets/resources/art-samples",
    "files": [
      "v1/manifest.json",
      "v1/forest-map-1.jpg",
      "v1/card-frame.png",
      "v1/panel.png",
      "v1/button-normal.png",
      "v1/button-selected.png",
      "v1/button-pressed.png",
      "v1/button-disabled.png",
      "v1/guard-atlas.png"
    ]
  }
}
